# ============================================================
# POS Software — Custom .gitignore
# Stack: React + Vite + TypeScript + Tailwind v4 (pnpm)
#        Python backend (FastAPI/Alembic/SQLAlchemy)
# ============================================================


# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.so
.Python

# Virtual environments
pos_venv/
venv/
.venv/
env/
ENV/

# Python test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── Environment & Secrets ────────────────────────────────────
.env
.env.local
.env.*.local
# Keep the example file — it's safe to commit
!.env.example
!backend/.env.example


# ── Node / pnpm / Vite ───────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local

# pnpm
.pnpm-store/
.pnpm-debug.log*

# npm / yarn (in case tooling switches)
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo


# ── Graphify knowledge graph outputs ─────────────────────────
graphify-out/cache/
graphify-out/graph.json
graphify-out/graph.html
graphify-out/GRAPH_REPORT.md
graphify-out/.graphify_labels.json
graphify-out/.graphify_python
graphify-out/.graphify_root
# Keep the wiki if it exists (useful docs)
# !graphify-out/wiki/


# ── Database ─────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3


# ── OS-specific ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db


# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# ── Logs ─────────────────────────────────────────────────────
*.log
logs/


# ── Miscellaneous build helpers ──────────────────────────────
audit_imports.py
extract_ast.py
extract_graph.py
